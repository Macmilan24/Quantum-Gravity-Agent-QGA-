# =========================
# Global / OS / IDE
# =========================
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
*.swp
*.swo

# =========================
# Backend (Python / Poetry)
# =========================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
backend/venv/
backend/.venv/
backend/env/

# Environment Variables (CRITICAL: Never commit these)
backend/.env
backend/.env.*

# Testing & Coverage
backend/.pytest_cache/
backend/.mypy_cache/
backend/htmlcov/
backend/.coverage
backend/coverage.xml

# Distribution / Packaging
backend/dist/
backend/build/
backend/*.egg-info/

# Jupyter Notebooks (Optional: ignore checkpoints)
backend/.ipynb_checkpoints

# =========================
# Frontend (Next.js / Node)
# =========================
# Dependencies
frontend/node_modules/

# Next.js build output
frontend/.next/
frontend/out/

# Production build
frontend/build/
frontend/dist/

# Environment Variables (CRITICAL: Never commit these)
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Debug logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*

# Vercel
frontend/.vercel

# Testing & Coverage
frontend/coverage/
frontend/cypress/videos
frontend/cypress/screenshots

# =========================
# Miscellaneous
# =========================
# Local history (if using VS Code extension)
.history/
